          "min": 20.0,
          "why": "fission heats the fuel; the guide tubes hold only water"
        },
        {
          "result": "vtk_written",
          "equals": true,
          "why": "the tally goes out to a VTK file for ParaView or VisIt"
        }
      ]
    }
