# AutoMC's keys file: a template. Copy it OUTSIDE the AutoMC folder (AutoMC refuses a keys file inside it, because the folder is
# published), fill in the values, and name it in AUTOMC_ENV_FILE. In WSL:
#
#     mkdir -p ~/.config/automc
#     cp config/keys.env.example ~/.config/automc/keys.env
#     chmod 600 ~/.config/automc/keys.env
#     echo 'export AUTOMC_ENV_FILE=~/.config/automc/keys.env' >> ~/.bashrc
#
# AutoMC takes only the names below (and any other api_key_env in llm.yaml); a variable set in the shell wins over this file. Leave
# a value empty when you do not have that key. Check with: python -m automc models list (it shows where each key comes from, never
# its value).

# Language models (config/llm.yaml names them in api_key_env). Each key makes its route's models appear in /model; comment a key out
# (put # in front) to hide that route. OpenAI directly (your own account) and OpenAI through Portkey (UT's account) can both be set.
OPENAI_API_KEY=
PORTKEY_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# The model `python -m automc chat` starts with (without this: the local model). Keep at most one line uncommented; the choices are
# what `python -m automc models discover` lists, and a cloud one must have passed `models check CHOICE --tools` once.
# AUTOMC_LLM_PROVIDER=openai/gpt-5.4                         # OpenAI directly
# AUTOMC_LLM_PROVIDER=openai-portkey/@<your-slug>/gpt-5.4    # OpenAI through Portkey
# AUTOMC_LLM_PROVIDER=gemini/gemini-3.8-flash
# AUTOMC_LLM_PROVIDER=local

# Web search (GT-4)
TAVILY_API_KEY=

# LangSmith: traces only what a cloud model may see (agent/tracing.py). Set AUTOMC_TRACING=langsmith to switch it on.
LANGSMITH_API_KEY=
AUTOMC_TRACING=
# AUTOMC_LANGSMITH_PROJECT=automc
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
